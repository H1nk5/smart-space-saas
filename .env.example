DEBUG=true
HOST=127.0.0.1
PORT=8080

# Required when DEBUG=false. Use a unique random value of at least 32 bytes.
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Docker Compose deployment
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DEMO_ADMIN_PASSWORD=replace-with-a-demo-password-at-least-10-chars
